# ─── Servidor ───
PORT=3621
# CORS_ORIGIN=http://localhost:5176

# ─── Seguridad (OBLIGATORIO cambiar en producción) ───
JWT_SECRET=pgr-dev-secret-cambiar-en-produccion
ADMIN_DOC=00000000-0
ADMIN_PASSWORD=AdminPGR2024!

# Llave de cifrado de correos en reposo (AES-256-GCM), 64 hex = 32 bytes.
# Generar con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠ OBLIGATORIA en producción. Cambiarla hace ILEGIBLE todo lo ya cifrado.
# FIELD_ENCRYPTION_KEY=

# ─── SQL Server ───
# Autenticación Windows (local, instancia SQLEXPRESS):
DB_TRUSTED_CONNECTION=true
DB_SERVER=localhost
DB_INSTANCE=SQLEXPRESS
DB_DATABASE=PGR_Compras
DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_SERVER_CERTIFICATE=true

# Autenticación SQL (producción / servidor remoto):
# DB_TRUSTED_CONNECTION=false
# DB_USER=pgr_app
# DB_PASSWORD=
# DB_PORT=1433
# DB_ENCRYPT=true

# ─── Datos de demostración (false para arrancar sin datos demo) ───
SEED_DEMO_DATA=true

# ─── Correo electrónico ───
# Solo si un antivirus (AVG/Avast Mail Shield) intercepta los puertos de correo:
# EMAIL_ALLOW_INVALID_CERTS=true

# ─── Gemini (opcional: si se define, tiene prioridad sobre la API key guardada en BD) ───
# GEMINI_API_KEY=AIza...
